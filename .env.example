# 数据库 SQLite 文件路径（在容器内为 /data/baby-food.db）
DATABASE_URL=file:/data/baby-food.db

# 后端端口（容器内）
PORT=3000

# 时区，必须设为 Asia/Shanghai，否则记录时间会差 8 小时
TZ=Asia/Shanghai

# 运行环境
NODE_ENV=production

# ====== AI 问答（DeepSeek，OpenAI 兼容协议）======
# docker compose 会自动加载本文件，把值注入 api 容器
# KEY 申请：https://platform.deepseek.com → API Keys
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ====== 宝宝信息（可选）======
# 出生日期 YYYY-MM-DD：月龄展示 + AI 上下文
BABY_BIRTH=
# 小名：徽标与 AI 称呼，留空显示「宝宝」
BABY_NICKNAME=
