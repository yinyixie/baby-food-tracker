# 数据库
DATABASE_URL=file:./data/baby-food.db
PORT=3000
TZ=Asia/Shanghai
NODE_ENV=development

# ====== AI 问答（OpenAI 兼容协议） ======
# 留空时 /api/ai/chat 会返 503，前端「问AI」页会显示配置提示
# KEY 申请：https://platform.deepseek.com → API Keys（格式 sk-...）
# 本机开发：填好这三行后 `make` 会自动读取本文件并注入后端进程
# NAS 部署：改 docker-compose.yml 同目录的 .env（不是本文件），见 DEPLOY.md
AI_API_KEY=
# 默认 DeepSeek。其他厂商：
# OpenAI：https://api.openai.com/v1
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# 月之暗面：https://api.moonshot.cn/v1
AI_BASE_URL=https://api.deepseek.com/v1
# DeepSeek: deepseek-chat（V3）/ deepseek-reasoner（R1）
# OpenAI: gpt-4o-mini / gpt-4o ｜ 通义: qwen-turbo / qwen-plus ｜ 月之暗面: moonshot-v1-8k
AI_MODEL=deepseek-chat

# ====== 宝宝信息（可选）======
# 出生日期 YYYY-MM-DD：月龄展示 + AI 上下文
BABY_BIRTH=
# 小名：徽标与 AI 称呼，留空显示「宝宝」
BABY_NICKNAME=
